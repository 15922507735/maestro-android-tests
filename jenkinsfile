pipeline {
    agent any
    
    tools {
        jdk 'JDK17'
    }
    
    environment {
        PATH = "C:\\maestro\\bin;C:\\Program Files\\Git\\bin;C:\\Windows\\System32;${env.PATH}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "代码已检出"
            }
        }
        
        stage('Verify Environment') {
            steps {
                bat '''
                    echo "=== Environment Check ==="
                    java -version
                    git --version
                    maestro --version
                '''
            }
        }
        
        stage('Run Maestro Tests') {
            steps {
                bat '''
                    if not exist test-reports mkdir test-reports
                    maestro test flows/ --format junit --output test-reports/maestro-report.xml
                '''
            }
            post {
                always {
                    junit 'test-reports/*.xml'
                }
            }
        }
    }
    
    post {
        success {
            echo "All tests passed!"
        }
        failure {
            echo "Tests failed!"
        }
    }
}